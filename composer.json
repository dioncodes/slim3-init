{
	"name": "adeptoas/slim3-init",
	"type": "library",
	"description": "A very convenient support library for Slim 3",
	"license": "proprietary",
	"authors": [
		{
			"name": "Benjamin Schmidt",
			"email": "benjamin.schmidt@visma.com",
			"homepage": "https://bluefirex.de"
		}
	],
	"require": {
		"php": ">=8.0",
		"slim/slim": "^4.15.3",
		"php-di/php-di": "^7.1",
		"ext-mbstring": "*",
		"ext-json": "*",
		"slim/psr7": "^1.8"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.13"
	},
	"autoload": {
		"psr-4": {
			"Adepto\\Slim3Init\\": "src"
		}
	},
	"config": {
		"platform": {
			"php": "8.0.30"
		}
	},
	"scripts": {
		"test": [
			"@phpunit",
			"@phpcs"
		],
		"phpunit": "php vendor/bin/phpunit --bootstrap vendor/autoload.php tests",
		"phpcs": "php vendor/bin/phpcs --standard=phpcs_disabled.xml"
	}
}
